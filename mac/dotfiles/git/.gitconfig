[user]
    name  = Your Name
    email = you@email.com

[init]
    defaultBranch = main

[core]
    editor       = nvim
    autocrlf     = input
    excludesfile = ~/.gitignore_global

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[alias]
    st   = status -sb
    lg   = log --oneline --graph --decorate
    co   = checkout
    cm   = commit -m
    undo = reset --soft HEAD~1
    wip  = !git add -A && git commit -m "wip"
